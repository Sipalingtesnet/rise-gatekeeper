# rise — Proof Gatekeeper agent, zkVerify Agent Games Season 01.
# Copy to `.env` and fill in. NEVER commit a filled-in .env.
# (`.env` is git-ignored; this file holds only empty placeholders.)

# REQUIRED. HMAC secret for the agent interface, copied from the Agent Games
# dashboard ("Rotate Secret"). The platform reveals it once — copy the
# plaintext and paste it here. Without it, POST /agent refuses everything.
AGENT_GAMES_HMAC_SECRET=

# Port the service listens on. Default 3000.
PORT=3000

# --- Proof module (real implementation — see README "Proofs") ---
# Proofs are attempted only when PROOF_ENABLED=1 AND the circuit artifacts
# exist (they ship in circuits/) AND a Kurier API key is set. Until then
# the decision path omits the proof fields.
# PROOF_ENABLED=0
# ZK_WASM_PATH=circuits/gatekeeper.wasm   # defaults to circuits/ in this repo
# ZK_ZKEY_PATH=circuits/gatekeeper_final.zkey

# REQUIRED for proofs. Kurier mainnet API key — create one at
# https://kurier.xyz (sign up for mainnet). The key goes in the Kurier
# request path (POST /submit-proof/{key}); it is never sent as a header
# and never appears in logs. Without it, submitProof returns ok:false.
# KURIER_API_KEY=

# Optional override for the Kurier API base. Default is the mainnet API:
# https://api.kurier.xyz/api/v1 (testnet: https://api-testnet.kurier.xyz/api/v1).
# KURIER_API_URL=https://api.kurier.xyz/api/v1
